# The fips worktree is tracked by ~/fips (branch android-hooks), not here.
/fips/

# Rust (Cargo.lock stays tracked — it pins rustables 0.8.7 for host builds)
target/

# Android / Gradle
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
/android/keystore.properties
/android/app/src/main/jniLibs/

# Toolchain archives
*.zip
*.tar.gz
/dist/

# Zapstore publishing scratch. .env holds SIGN_WITH — a bunker:// URI with a
# live secret token — and signing-crt_*.txt is an exported signing certificate.
# Neither belongs in the repo; the first would leak a credential.
/.env
/signing-crt_*.txt
