<?xml version="1.0" encoding="utf-8"?>
<!-- The page scrolls: the Sessions text and the mDNS peer list both grow
     without bound, and before this they simply pushed Logs (and the version
     row) off the bottom of a fixed-height LinearLayout with no way to reach
     them. -->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="96dp">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Resolve / reachability -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Fips.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Widget.Fips.CardTitle"
                android:text="Resolve / ping an npub" />

            <TextView
                style="@style/Widget.Fips.Summary"
                android:text="Turn an npub into its mesh address, or ask the running node whether it has a link or a route to it." />

            <com.google.android.material.textfield.TextInputLayout
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="npub1… or a mesh name">
                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/probe_npub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/resolve"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:text="Resolve" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reachability"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:text="Check reachability" />
            </LinearLayout>

            <!-- Hidden until there is a result to show. -->
            <TextView
                android:id="@+id/probe_result"
                style="@style/Widget.Fips.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:visibility="gone" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Live FMP / FSP sessions -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Fips.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Widget.Fips.CardTitle"
                android:text="Sessions" />

            <TextView
                style="@style/Widget.Fips.Summary"
                android:text="Direct links to peers (FMP) and end-to-end encrypted sessions (FSP). ▲ parent · ▼ child." />

            <TextView
                android:id="@+id/sessions_view"
                style="@style/Widget.Fips.Mono"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_field"
                android:padding="12dp"
                android:textIsSelectable="true"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Nearby peers seen via mDNS LAN discovery -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Fips.Card">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                style="@style/Widget.Fips.CardTitle"
                android:text="Nearby (mDNS)" />

            <TextView
                android:id="@+id/hotspot_status"
                style="@style/Widget.Fips.Summary"
                android:visibility="gone" />

            <TextView
                android:id="@+id/lan_empty"
                style="@style/Widget.Fips.Summary"
                android:layout_marginTop="8dp" />

            <ScrollView
                android:id="@+id/lan_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp">

                <LinearLayout
                    android:id="@+id/lan_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Logs -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.Fips.Card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            style="@style/Widget.Fips.CardTitle"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:text="Logs" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/expand_logs"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expand" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/copy_logs"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Copy" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_logs"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Refresh" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/log_scroll"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/bg_field"
        android:padding="12dp">

        <TextView
            android:id="@+id/log_view"
            style="@style/Widget.Fips.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textIsSelectable="true"
            android:textSize="11sp" />
    </ScrollView>

    </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/check_update"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="0dp"
            android:paddingVertical="4dp"
            android:text="Check for updates"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>

</androidx.core.widget.NestedScrollView>
