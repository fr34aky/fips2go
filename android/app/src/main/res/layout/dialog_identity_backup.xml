<?xml version="1.0" encoding="utf-8"?>
<!-- Reveals the nsec for backup. The key is selectable so it can be copied by
     hand as well as with the Copy button. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="8dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="This is your node's secret key. Anyone who has it can impersonate your node on the mesh. Store it in a password manager — not in plain cloud storage or a chat."
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/backup_nsec"
            style="@style/Widget.Fips.Mono"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_field"
            android:padding="12dp"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/backup_npub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</ScrollView>
