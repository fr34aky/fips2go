<?xml version="1.0" encoding="utf-8"?>
<!-- Connect toggle fill: activated = connected, selected = starting.
     Driven from XML states so Kotlin never has to resolve theme attrs (the
     project builds with non-transitive R classes). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorPrimary" android:state_activated="true" />
    <item android:color="?attr/colorSecondaryContainer" android:state_selected="true" />
    <item android:color="?attr/colorSurfaceContainerLowest" />
</selector>
